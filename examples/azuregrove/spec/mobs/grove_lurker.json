{
  "$schema": "../../.modcreator/schema/mob.json",
  "kind": "mob",
  "id": "grove_lurker",
  "name": "Grove Lurker",
  "mob": {
    "model": "zombie",
    "behavior": "hostile",
    "attackDamage": 3,
    "texture": "art/grove_lurker.png",
    "health": 16,
    "speed": 0.28,
    "width": 0.6,
    "height": 1.95,
    "drops": [{ "item": "azure_plum", "min": 0, "max": 2 }],
    "spawnEgg": "art/grove_lurker_spawn_egg.png",
    "goals": [
      { "goal": "float", "priority": 0 },
      { "goal": "avoid_entity", "priority": 1, "args": { "avoidClass": "minecraft:wolf", "maxDist": 8, "walkSpeedModifier": 1, "sprintSpeedModifier": 1.3 } },
      { "goal": "melee_attack", "priority": 2, "args": { "speedModifier": 1, "followingTargetEvenIfNotSeen": false } },
      { "goal": "move_towards_restriction", "priority": 5, "args": { "speedModifier": 1 } },
      { "goal": "water_avoiding_random_stroll", "priority": 7, "args": { "speedModifier": 0.8 } },
      { "goal": "look_at_player", "priority": 8, "args": { "lookAtType": "minecraft:player", "lookDistance": 8 } },
      { "goal": "random_look_around", "priority": 8 },
      { "goal": "hurt_by_target", "priority": 1, "calls": { "setAlertOthers": {} } },
      { "goal": "nearest_attackable_target", "priority": 2, "args": { "targetType": "minecraft:player", "mustSee": true } },
      { "goal": "nearest_attackable_target", "priority": 3, "args": { "targetType": "minecraft:villager", "mustSee": false } }
    ]
  }
}
