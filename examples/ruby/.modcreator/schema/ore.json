{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "ore"
    },
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "ore": {
      "type": "object",
      "properties": {
        "block": {
          "type": "string",
          "pattern": "^(#?[a-z0-9_.-]+:)?[a-z0-9_/.-]+$"
        },
        "deepslateBlock": {
          "type": "string",
          "pattern": "^(#?[a-z0-9_.-]+:)?[a-z0-9_/.-]+$"
        },
        "replaces": {
          "default": "stone_and_deepslate",
          "type": "string",
          "enum": [
            "stone",
            "deepslate",
            "stone_and_deepslate",
            "netherrack",
            "end_stone"
          ]
        },
        "veinSize": {
          "default": 8,
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "veinsPerChunk": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "minY": {
          "default": -64,
          "type": "integer",
          "minimum": -64,
          "maximum": 320
        },
        "maxY": {
          "default": 64,
          "type": "integer",
          "minimum": -64,
          "maximum": 320
        },
        "distribution": {
          "default": "uniform",
          "type": "string",
          "enum": [
            "uniform",
            "triangle"
          ]
        },
        "airExposureSkip": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "block"
      ]
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "ore"
  ]
}
