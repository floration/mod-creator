{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "modId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "default": "0.1.0",
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "authors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "package": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*$"
    },
    "profile": {
      "default": "26.3",
      "type": "string",
      "const": "26.3"
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "required": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "slug",
          "version"
        ]
      }
    }
  },
  "required": [
    "modId",
    "name",
    "package"
  ]
}
