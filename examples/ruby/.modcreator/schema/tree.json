{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "tree"
    },
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "creativeTab": {
      "default": "natural_blocks",
      "type": "string",
      "enum": [
        "building_blocks",
        "colored_blocks",
        "natural_blocks",
        "functional_blocks",
        "redstone_blocks",
        "tools_and_utilities",
        "combat",
        "food_and_drinks",
        "ingredients",
        "spawn_eggs"
      ]
    },
    "tree": {
      "type": "object",
      "properties": {
        "logSide": {
          "type": "string"
        },
        "logEnd": {
          "type": "string"
        },
        "planks": {
          "type": "string"
        },
        "leaves": {
          "type": "string"
        },
        "sapling": {
          "type": "string"
        },
        "shape": {
          "default": "oak",
          "type": "string",
          "enum": [
            "oak",
            "fancy_oak",
            "birch",
            "super_birch",
            "jungle",
            "swamp_oak",
            "jungle_bush",
            "spruce",
            "pine",
            "acacia",
            "cherry",
            "azalea",
            "poplar",
            "dark_oak",
            "mega_spruce",
            "mega_pine",
            "mega_jungle",
            "custom"
          ]
        },
        "trunkHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "trunkHeightRandom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "leafRadius": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "custom": {
          "type": "object",
          "properties": {
            "layers": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[.LXZ# ]*$"
                }
              }
            },
            "origin": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "randomRotation": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "layers"
          ]
        },
        "saplingChance": {
          "default": 0.05,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fruit": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "pattern": "^(#?[a-z0-9_.-]+:)?[a-z0-9_/.-]+$"
            },
            "chance": {
              "default": 0.02,
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "item"
          ]
        }
      },
      "required": [
        "logSide",
        "logEnd",
        "planks",
        "leaves",
        "sapling"
      ]
    },
    "shapes": {
      "default": {
        "stairs": false,
        "slab": false,
        "wall": false,
        "fence": false,
        "fenceGate": false,
        "button": false,
        "pressurePlate": false
      },
      "type": "object",
      "properties": {
        "stairs": {
          "default": false,
          "type": "boolean"
        },
        "slab": {
          "default": false,
          "type": "boolean"
        },
        "wall": {
          "default": false,
          "type": "boolean"
        },
        "fence": {
          "default": false,
          "type": "boolean"
        },
        "fenceGate": {
          "default": false,
          "type": "boolean"
        },
        "button": {
          "default": false,
          "type": "boolean"
        },
        "pressurePlate": {
          "default": false,
          "type": "boolean"
        },
        "door": {
          "type": "object",
          "properties": {
            "top": {
              "type": "string"
            },
            "bottom": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            }
          },
          "required": [
            "top",
            "bottom",
            "icon"
          ]
        },
        "trapdoor": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "tree"
  ]
}
