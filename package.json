{
  "name": "mod-creator",
  "private": true,
  "version": "0.2.0",
  "description": "GUI tool for building Minecraft 26.3+ Fabric mods from spec files",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/app"
  ],
  "scripts": {
    "build": "npm run build -w @modcreator/core -w @modcreator/cli -w @modcreator/app",
    "test": "npm test -w @modcreator/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "app": "node scripts/start.mjs",
    "example": "node packages/cli/dist/index.js generate examples/ruby",
    "extract-vanilla": "node scripts/extract-vanilla.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
