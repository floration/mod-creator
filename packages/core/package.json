{
  "name": "@modcreator/core",
  "version": "0.1.0",
  "description": "Spec schemas, loader and code generator for Mod Creator",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./modrinth": {
      "types": "./dist/modrinth.d.ts",
      "default": "./dist/modrinth.js"
    },
    "./recipe-grid": {
      "types": "./dist/recipeGrid.d.ts",
      "default": "./dist/recipeGrid.js"
    },
    "./blockbench": {
      "types": "./dist/blockbench.d.ts",
      "default": "./dist/blockbench.js"
    },
    "./nbt": {
      "types": "./dist/nbt.d.ts",
      "default": "./dist/nbt.js"
    },
    "./trees": {
      "types": "./dist/trees.d.ts",
      "default": "./dist/trees.js"
    }
  },
  "files": [
    "dist",
    "profiles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
