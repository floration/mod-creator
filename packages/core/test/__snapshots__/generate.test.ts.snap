package com.example.azuregrove.generated;

import net.fabricmc.api.ClientModInitializer;

import net.minecraft.client.renderer.entity.EntityRenderers;
import com.example.azuregrove.generated.client.BluetuskRenderer;
import com.example.azuregrove.generated.client.GroveLurkerRenderer;

/** Client-side setup for generated content. fabric.mod.json lists this class as the "client" entrypoint. */
public final class ModContentClient implements ClientModInitializer {
	@Override
	public void onInitializeClient() {
		EntityRenderers.register(ModContent.BLUETUSK, BluetuskRenderer::new);
		EntityRenderers.register(ModContent.GROVE_LURKER, GroveLurkerRenderer::new);
	}
}
