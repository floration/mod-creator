import net.minecraft.world.level.block.TintedParticleLeavesBlock;
import net.minecraft.world.level.block.grower.TreeGrower;
import net.minecraft.world.level.block.state.BlockBehaviour;
import net.minecraft.world.level.levelgen.GenerationStep;
import net.minecraft.world.level.levelgen.Heightmap;

public final class ModContent {
	public static final String MOD_ID = "azuregrove";

	private static final ToolMaterial AZURITE_SWORD_MATERIAL = new ToolMaterial(BlockTags.INCORRECT_FOR_IRON_TOOL,
			600, 7.0f, 0.0f, 18, TagKey.create(Registries.ITEM, id("azurite_sword_repair_items")));
	private static final ArmorMaterial AZURITE_MATERIAL = new ArmorMaterial(22,
			Map.of(ArmorType.HELMET, 2, ArmorType.CHESTPLATE, 7, ArmorType.LEGGINGS, 5, ArmorType.BOOTS, 2, ArmorType.BODY, 7),
			18, SoundEvents.ARMOR_EQUIP_DIAMOND, 1.0f, 0.0f,
			TagKey.create(Registries.ITEM, id("azurite_repair_items")),
			ResourceKey.create(EquipmentAssets.ROOT_ID, id("azurite")));

	/** Azurite Bricks (spec/blocks/azurite_bricks.json) */
	public static final Block AZURITE_BRICKS = registerBlock("azurite_bricks", Block::new,
			BlockBehaviour.Properties.of()
			.strength(2.0f, 6.0f)
			.sound(SoundType.DEEPSLATE)
			.requiresCorrectToolForDrops()
			.lightLevel(state -> 4), true);

	/** Azurite Ore (spec/blocks/azurite_ore.json) */
	public static final Block AZURITE_ORE = registerBlock("azurite_ore", Block::new,
			BlockBehaviour.Properties.of()
			.strength(3.0f, 3.0f)
			.sound(SoundType.STONE)
			.requiresCorrectToolForDrops(), true);

	// Azurewood wood (spec/trees/azurewood.json)
	private static final TreeGrower AZUREWOOD_GROWER = new TreeGrower("azuregrove:azurewood",
			WeightedList.of(ResourceKey.create(Registries.FEATURE, id("azurewood"))), WeightedList.of(), WeightedList.of(), ResourceKey.create(Registries.FEATURE, id("azurewood")));
	public static final Block AZUREWOOD_LOG = registerBlock("azurewood_log", RotatedPillarBlock::new,
			BlockBehaviour.Properties.ofFullCopy(Blocks.OAK_LOG), true);
	public static final Block AZUREWOOD_PLANKS = registerBlock("azurewood_planks", Block::new,
			BlockBehaviour.Properties.ofFullCopy(Blocks.OAK_PLANKS), true);
	public static final Block AZUREWOOD_LEAVES = registerBlock("azurewood_leaves", properties -> new TintedParticleLeavesBlock(0.01f, properties),
			BlockBehaviour.Properties.ofFullCopy(Blocks.OAK_LEAVES), true);
	public static final Block AZUREWOOD_SAPLING = registerBlock("azurewood_sapling", properties -> new SaplingBlock(AZUREWOOD_GROWER, properties),
			BlockBehaviour.Properties.ofFullCopy(Blocks.OAK_SAPLING), true);

	/** Azure Grass (spec/plants/azure_grass.json) */
	public static final Block AZURE_GRASS = registerBlock("azure_grass", BushBlock::new,
			BlockBehaviour.Properties.ofFullCopy(Blocks.SHORT_GRASS), true);

	/** Azure Plum (spec/items/azure_plum.json) */
	public static final Item AZURE_PLUM = registerItem("azure_plum", Item::new, new Item.Properties()
			.food(new FoodProperties.Builder().nutrition(4).saturationModifier(0.6f).build()));

	/** Azurite (spec/items/azurite.json) */
	public static final Item AZURITE = registerItem("azurite", Item::new, new Item.Properties().rarity(Rarity.UNCOMMON));

	/** Azurite Sword (spec/tools/azurite_sword.json) */
	public static final Item AZURITE_SWORD = registerItem("azurite_sword", Item::new,
			new Item.Properties().sword(AZURITE_SWORD_MATERIAL, 5.5f, -2.4f));

	/** Azurite helmet (spec/armor/azurite.json) */
	public static final Item AZURITE_HELMET = registerItem("azurite_helmet", Item::new,
			new Item.Properties().humanoidArmor(AZURITE_MATERIAL, ArmorType.HELMET));

	/** Azurite chestplate (spec/armor/azurite.json) */
	public static final Item AZURITE_CHESTPLATE = registerItem("azurite_chestplate", Item::new,
			new Item.Properties().humanoidArmor(AZURITE_MATERIAL, ArmorType.CHESTPLATE));

	/** Azurite leggings (spec/armor/azurite.json) */
	public static final Item AZURITE_LEGGINGS = registerItem("azurite_leggings", Item::new,
			new Item.Properties().humanoidArmor(AZURITE_MATERIAL, ArmorType.LEGGINGS));

	/** Azurite boots (spec/armor/azurite.json) */
	public static final Item AZURITE_BOOTS = registerItem("azurite_boots", Item::new,
			new Item.Properties().humanoidArmor(AZURITE_MATERIAL, ArmorType.BOOTS));

	/** Bluetusk (spec/mobs/bluetusk.json) */
	public static final EntityType<Bluetusk> BLUETUSK = registerEntity("bluetusk",
			EntityType.Builder.of(Bluetusk::new, MobCategory.CREATURE).sized(0.9f, 0.9f));
	public static final Item BLUETUSK_SPAWN_EGG = registerItem("bluetusk_spawn_egg", SpawnEggItem::new, new Item.Properties().spawnEgg(BLUETUSK));

	private ModContent() {
	}

	/** Call once from your mod initializer. Loading this class registers everything above. */
	public static void register() {
		CreativeModeTabEvents.modifyOutputEvent(CreativeModeTabs.BUILDING_BLOCKS).register(output -> {
			output.accept(AZURITE_BRICKS.asItem());
		});
		CreativeModeTabEvents.modifyOutputEvent(CreativeModeTabs.NATURAL_BLOCKS).register(output -> {
			output.accept(AZURITE_ORE.asItem());
			output.accept(AZUREWOOD_LOG.asItem());
			output.accept(AZUREWOOD_PLANKS.asItem());
			output.accept(AZUREWOOD_LEAVES.asItem());
			output.accept(AZUREWOOD_SAPLING.asItem());
			output.accept(AZURE_GRASS.asItem());
		});
		CreativeModeTabEvents.modifyOutputEvent(CreativeModeTabs.FOOD_AND_DRINKS).register(output -> {
			output.accept(AZURE_PLUM);
		});
		CreativeModeTabEvents.modifyOutputEvent(CreativeModeTabs.INGREDIENTS).register(output -> {
			output.accept(AZURITE);
		});
		CreativeModeTabEvents.modifyOutputEvent(CreativeModeTabs.COMBAT).register(output -> {
			output.accept(AZURITE_SWORD);
			output.accept(AZURITE_HELMET);
			output.accept(AZURITE_CHESTPLATE);
			output.accept(AZURITE_LEGGINGS);
			output.accept(AZURITE_BOOTS);
		});
		CreativeModeTabEvents.modifyOutputEvent(CreativeModeTabs.SPAWN_EGGS).register(output -> {
			output.accept(BLUETUSK_SPAWN_EGG);
		});
		// Azurewood wood burns like oak.
		FlammableBlockRegistry.getDefaultInstance().add(AZUREWOOD_LOG, 5, 5);
		FlammableBlockRegistry.getDefaultInstance().add(AZUREWOOD_PLANKS, 5, 20);
		FlammableBlockRegistry.getDefaultInstance().add(AZUREWOOD_LEAVES, 30, 60);
		// Bluetusk (spec/mobs/bluetusk.json)
		FabricDefaultAttributeRegistry.register(BLUETUSK, Animal.createAnimalAttributes()
				.add(Attributes.MAX_HEALTH, 12.0)
				.add(Attributes.MOVEMENT_SPEED, 0.25));
		SpawnPlacements.register(BLUETUSK, SpawnPlacementTypes.ON_GROUND, Heightmap.Types.MOTION_BLOCKING_NO_LEAVES, Animal::checkAnimalSpawnRules);
		// Azurite ore vein (spec/worldgen/azurite_ore_vein.json)
		BiomeModifications.addFeature(BiomeSelectors.foundInOverworld(), GenerationStep.Decoration.UNDERGROUND_ORES,
				ResourceKey.create(Registries.PLACED_FEATURE, id("azurite_ore_vein")));
	}

	private static Block registerBlock(String name, Function<BlockBehaviour.Properties, Block> factory,
			BlockBehaviour.Properties properties, boolean withItem) {
		ResourceKey<Block> blockKey = ResourceKey.create(Registries.BLOCK, id(name));
		Block block = factory.apply(properties.setId(blockKey));
		if (withItem) {
			ResourceKey<Item> itemKey = ResourceKey.create(Registries.ITEM, id(name));
			Registry.register(BuiltInRegistries.ITEM, itemKey,
					new BlockItem(block, new Item.Properties().setId(itemKey).useBlockDescriptionPrefix()));
		}
		return Registry.register(BuiltInRegistries.BLOCK, blockKey, block);
	}

	private static Item registerItem(String name, Function<Item.Properties, Item> factory, Item.Properties properties) {
		ResourceKey<Item> key = ResourceKey.create(Registries.ITEM, id(name));
		return Registry.register(BuiltInRegistries.ITEM, key, factory.apply(properties.setId(key)));
	}

	private static <T extends Entity> EntityType<T> registerEntity(String name, EntityType.Builder<T> builder) {
		ResourceKey<EntityType<?>> key = ResourceKey.create(Registries.ENTITY_TYPE, id(name));
		return Registry.register(BuiltInRegistries.ENTITY_TYPE, key, builder.build(key));
	}

	static Identifier id(String path) {
		return Identifier.fromNamespaceAndPath(MOD_ID, path);
	}
}
