  "src/generated/java/com/example/ruby/generated/client/GlowmothRenderer.java": "// Generated by Mod Creator from spec/. Do not edit: this file is rewritten on every generate.
// Put hand-written code in src/main/java instead.
package com.example.ruby.generated.client;

import com.mojang.blaze3d.vertex.PoseStack;
import net.minecraft.client.renderer.entity.EntityRendererProvider;
import net.minecraft.client.renderer.entity.MobRenderer;
import net.minecraft.client.renderer.entity.state.LivingEntityRenderState;
import net.minecraft.resources.Identifier;

import com.example.ruby.generated.ModContent;
import com.example.ruby.generated.entity.Glowmoth;

/** Draws Glowmoth with its Blockbench model (spec/mobs/glowmoth.json). */
public class GlowmothRenderer extends MobRenderer<Glowmoth, LivingEntityRenderState, GlowmothModel> {
	private static final Identifier TEXTURE = Identifier.fromNamespaceAndPath(ModContent.MOD_ID, "textures/entity/glowmoth.png");
	private static final Identifier BABY_TEXTURE = Identifier.fromNamespaceAndPath(ModContent.MOD_ID, "textures/entity/glowmoth_baby.png");

	public GlowmothRenderer(EntityRendererProvider.Context context) {
		super(context, new GlowmothModel(context.bakeLayer(GlowmothModel.LAYER)), 0.2f);
	}

	@Override
	public LivingEntityRenderState createRenderState() {
		return new LivingEntityRenderState();
	}

	@Override
	public Identifier getTextureLocation(LivingEntityRenderState state) {
		return state.isBaby ? BABY_TEXTURE : TEXTURE;
	}

	@Override
	protected void scale(LivingEntityRenderState state, PoseStack poseStack) {
		if (state.isBaby) poseStack.scale(0.5f, 0.5f, 0.5f);
	}
}
