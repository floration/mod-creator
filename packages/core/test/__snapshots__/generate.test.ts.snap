  "src/generated/java/com/example/azuregrove/generated/world/CustomTreeFeature.java": "// Generated by Mod Creator from spec/. Do not edit: this file is rewritten on every generate.
// Put hand-written code in src/main/java instead.
package com.example.azuregrove.generated.world;

import com.mojang.serialization.Codec;
import com.mojang.serialization.MapCodec;
import com.mojang.serialization.codecs.RecordCodecBuilder;
import java.util.List;
import net.minecraft.core.BlockPos;
import net.minecraft.core.Direction;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.util.RandomSource;
import net.minecraft.world.level.WorldGenLevel;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.level.block.Blocks;
import net.minecraft.world.level.block.LeavesBlock;
import net.minecraft.world.level.block.RotatedPillarBlock;
import net.minecraft.world.level.block.Rotation;
import net.minecraft.world.level.block.state.BlockState;
import net.minecraft.world.level.chunk.ChunkGenerator;
import net.minecraft.world.level.levelgen.feature.Feature;
import net.minecraft.world.level.levelgen.feature.TreeFeature;

/**
 * A tree built by hand in Mod Creator: fixed log and leaf positions relative to the sapling, optionally turned
 * a random quarter turn. Like a vanilla tree it only grows if every block it needs is air or replaceable.
 */
public record CustomTreeFeature(
		Block log,
		Block leaves,
		List<BlockPos> logsY,
		List<BlockPos> logsX,
		List<BlockPos> logsZ,
		List<List<BlockPos>> leavesByDistance,
		boolean randomRotation
) implements Feature {
	public static final MapCodec<CustomTreeFeature> CODEC = RecordCodecBuilder.mapCodec(i -> i.group(
			BuiltInRegistries.BLOCK.byNameCodec().fieldOf("log").forGetter(CustomTreeFeature::log),
			BuiltInRegistries.BLOCK.byNameCodec().fieldOf("leaves").forGetter(CustomTreeFeature::leaves),
			BlockPos.CODEC.listOf().optionalFieldOf("logs_y", List.of()).forGetter(CustomTreeFeature::logsY),
			BlockPos.CODEC.listOf().optionalFieldOf("logs_x", List.of()).forGetter(CustomTreeFeature::logsX),
			BlockPos.CODEC.listOf().optionalFieldOf("logs_z", List.of()).forGetter(CustomTreeFeature::logsZ),
			BlockPos.CODEC.listOf().listOf().optionalFieldOf("leaves_by_distance", List.of()).forGetter(CustomTreeFeature::leavesByDistance),
			Codec.BOOL.optionalFieldOf("random_rotation", true).forGetter(CustomTreeFeature::randomRotation)
	).apply(i, CustomTreeFeature::new));

	@Override
	public MapCodec<CustomTreeFeature> codec() {
		return CODEC;
	}

	@Override
	public boolean place(WorldGenLevel level, ChunkGenerator generator, RandomSource random, BlockPos origin) {
		Rotation rotation = this.randomRotation ? Rotation.getRandom(random) : Rotation.NONE;
		for (List<BlockPos> part : List.of(this.logsY, this.logsX, this.logsZ)) {
			for (BlockPos offset : part) {
				if (!TreeFeature.validTreePos(level, origin.offset(offset.rotate(rotation)))) return false;
			}
		}
		for (List<BlockPos> ring : this.leavesByDistance) {
			for (BlockPos offset : ring) {
				if (!TreeFeature.validTreePos(level, origin.offset(offset.rotate(rotation)))) return false;
			}
		}
		placeLogs(level, origin, rotation, this.logsY, Direction.Axis.Y);
		placeLogs(level, origin, rotation, this.logsX, Direction.Axis.X);
		placeLogs(level, origin, rotation, this.logsZ, Direction.Axis.Z);
		for (int i = 0; i < this.leavesByDistance.size(); i++) {
			BlockState state = this.leaves.defaultBlockState().trySetValue(LeavesBlock.DISTANCE, Math.min(i + 1, LeavesBlock.DECAY_DISTANCE));
			for (BlockPos offset : this.leavesByDistance.get(i)) {
				level.setBlock(origin.offset(offset.rotate(rotation)), state, Block.UPDATE_ALL);
			}
		}
		return true;
	}

	private void placeLogs(WorldGenLevel level, BlockPos origin, Rotation rotation, List<BlockPos> offsets, Direction.Axis axis) {
		BlockState state = this.log.defaultBlockState().trySetValue(RotatedPillarBlock.AXIS, axis).rotate(rotation);
		for (BlockPos offset : offsets) {
			BlockPos pos = origin.offset(offset.rotate(rotation));
			level.setBlock(pos, state, Block.UPDATE_ALL);
			// Logs standing on grass turn it to dirt, as vanilla trees do.
			if (offset.getY() == 0 && level.getBlockState(pos.below()).is(Blocks.GRASS_BLOCK)) {
				level.setBlock(pos.below(), Blocks.DIRT.defaultBlockState(), Block.UPDATE_ALL);
			}
		}
	}
}
